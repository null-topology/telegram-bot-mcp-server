  "publishConfig": {
    "access": "public"
  },
  "files": [".build", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "description": "A Model Context Protocol (MCP) server for Telegram Bot API integration",
  "keywords": [
