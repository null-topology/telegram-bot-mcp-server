{"name":"copy-message","description":"Copy a message of any kind from one chat to another. Unlike forwarding, the copied message does not have a link to the original message. Supports common send options, an optional replacement caption with overflow after 1024 characters, and JSON message identifiers.","inputKeys":["caption","chatId","disableNotification","fromChatId","messageId","messageThreadId","parseMode","protectContent","replyToMessageId"]}
{"name":"create-chat-invite-link","description":"Create an additional invite link for a chat. The bot must be an administrator with the appropriate rights. Returns the new invite link.","inputKeys":["chatId","expireDate","memberLimit","name"]}
{"name":"delete-message","description":"Delete a message from a chat. Bots can delete their own messages, and incoming messages in groups/supergroups where they have the appropriate admin rights. A message can only be deleted if it was sent less than 48 hours ago.","inputKeys":["chatId","messageId"]}
{"name":"download-file","description":"Download a file (by file_id) into TELEGRAM_DOWNLOAD_DIR on the server host. Bots can download files of up to 20 MB in size. Returns JSON with the saved path, size, MIME type and file identifiers; the download URL is never returned.","inputKeys":["fileId"]}
{"name":"edit-message-caption","description":"Edit the caption of a media message previously sent by the bot. Captions are limited to 1024 characters and are never split; returns JSON message identifiers or an edit confirmation.","inputKeys":["caption","chatId","messageId","parseMode"]}
{"name":"edit-message-text","description":"Edit the text of a message previously sent by the bot. Supports formatting and link preview options and returns JSON message identifiers or an edit confirmation.","inputKeys":["chatId","disableLinkPreview","messageId","parseMode","text"]}
{"name":"export-chat-invite-link","description":"Generate a new primary invite link for a chat; any previously generated primary link is revoked. Returns the new invite link.","inputKeys":["chatId"]}
{"name":"forward-message","description":"Forward a message of any kind from one chat to another. The forwarded message keeps a link to the original sender. Supports thread, notification and content protection options and returns JSON message identifiers.","inputKeys":["chatId","disableNotification","fromChatId","messageId","messageThreadId","protectContent"]}
{"name":"get-chat","description":"Use this method to get up-to-date information about the chat. Returns detailed chat information or comprehensive error details.","inputKeys":["chatId"]}
{"name":"get-chat-administrators","description":"Get a list of administrators in a chat (all admins except other bots), including their custom titles and rights.","inputKeys":["chatId"]}
{"name":"get-chat-member","description":"get information about a member of a chat","inputKeys":["chatId","userId"]}
{"name":"get-chat-member-count","description":"Use this method to get the number of members in a chat","inputKeys":["chatId"]}
{"name":"get-file","description":"Get basic info about a file (by file_id). Bots can download files of up to 20 MB in size. The result contains no download URL.","inputKeys":["fileId"]}
{"name":"get-me","description":"A simple method for testing your bot's authentication token. Requires no parameters. Returns detailed bot information or comprehensive error details.","inputKeys":[]}
{"name":"get-my-commands","description":"Use this method to get the current list of the bot's commands","inputKeys":[]}
{"name":"get-my-description","description":"Use this method to get the bot's description","inputKeys":[]}
{"name":"get-my-name","description":"Use this method to get the bot's name","inputKeys":[]}
{"name":"get-my-short-description","description":"Use this method to get the current bot short description","inputKeys":[]}
{"name":"get-user-profile-photos","description":"Get a user's profile pictures, including file IDs that can be re-sent with send-photo.","inputKeys":["limit","offset","userId"]}
{"name":"kick-chat-member","description":"Kick a user from a group, a supergroup or a channel. Provides detailed error information if the operation fails.","inputKeys":["chatId","userId"]}
{"name":"leave-chat","description":"Make the bot leave a group, supergroup, or channel.","inputKeys":["chatId"]}
{"name":"pin-chat-message","description":"Pin a message in a chat. The bot must be an administrator with the 'can_pin_messages' right in groups and channels.","inputKeys":["chatId","disableNotification","messageId"]}
{"name":"promote-chat-member","description":"Promote a user to administrator in a supergroup or channel, or demote them by passing all rights as false. The bot must be an administrator with the appropriate rights.","inputKeys":["canChangeInfo","canDeleteMessages","canInviteUsers","canManageChat","canPinMessages","canPromoteMembers","canRestrictMembers","chatId","userId"]}
{"name":"restrict-chat-member","description":"Restrict a user in a supergroup (mute or limit what they can send). The bot must be an administrator with the appropriate rights. Pass all permissions as true to lift restrictions.","inputKeys":["canSendMedia","canSendMessages","canSendOtherMessages","canSendPolls","chatId","untilDate","userId"]}
{"name":"revoke-chat-invite-link","description":"Revoke an invite link created by the bot. If the primary link is revoked, a new one is automatically generated.","inputKeys":["chatId","inviteLink"]}
{"name":"send-animation","description":"Send an animation (GIF or H.264/MPEG-4 AVC video without sound) to a chat. Bots can send animation files of up to 50 MB in size. Captions exceeding 1024 characters continue as text messages; common send options and JSON message identifiers are supported. Media accepts a Telegram file_id, an http(s) URL, or an absolute local path, restricted to TELEGRAM_UPLOAD_ROOTS when it lists at least one directory (uploads up to 50 MB, with an optional filename).","inputKeys":["caption","chatId","disableNotification","filename","media","messageThreadId","parseMode","protectContent","replyToMessageId"]}
{"name":"send-audio","description":"Send an audio file to be displayed in the music player. Audio must be in .MP3 or .M4A format. Bots can send audio files of up to 50 MB in size. Captions exceeding 1024 characters continue as text messages; common send options and JSON message identifiers are supported. Media accepts a Telegram file_id, an http(s) URL, or an absolute local path, restricted to TELEGRAM_UPLOAD_ROOTS when it lists at least one directory (uploads up to 50 MB, with an optional filename).","inputKeys":["caption","chatId","disableNotification","filename","media","messageThreadId","parseMode","protectContent","replyToMessageId"]}
{"name":"send-chat-action","description":"Show a status indicator in the chat (e.g. 'typing…', 'sending photo…'). The status is shown for 5 seconds or until the next message arrives. Useful to signal that a longer operation is in progress. Supports a target message thread.","inputKeys":["action","chatId","messageThreadId"]}
{"name":"send-contact","description":"Send a phone contact to a chat. Supports common send options and returns JSON message identifiers.","inputKeys":["chatId","disableNotification","firstName","lastName","messageThreadId","phoneNumber","protectContent","replyToMessageId"]}
{"name":"send-dice","description":"Send an animated emoji that displays a random value (dice, darts, basketball, football, bowling, or slot machine). Supports common send options and returns JSON message identifiers.","inputKeys":["chatId","disableNotification","emoji","messageThreadId","protectContent","replyToMessageId"]}
{"name":"send-document","description":"Send a document/file (PDF, ZIP, text file, etc.) to a chat. Bots can send files of up to 50 MB in size. Captions exceeding 1024 characters continue as text messages; common send options and JSON message identifiers are supported. Media accepts a Telegram file_id, an http(s) URL, or an absolute local path, restricted to TELEGRAM_UPLOAD_ROOTS when it lists at least one directory (uploads up to 50 MB, with an optional filename).","inputKeys":["caption","chatId","disableNotification","filename","media","messageThreadId","parseMode","protectContent","replyToMessageId"]}
{"name":"send-location","description":"Send a point on the map (latitude/longitude) to a chat. Supports common send options and returns JSON message identifiers.","inputKeys":["chatId","disableNotification","latitude","longitude","messageThreadId","protectContent","replyToMessageId"]}
{"name":"send-media-group","description":"Send 2-10 photos, videos, documents or audio files as an album. Photos and videos can be mixed; documents and audio can only be grouped with items of their own type. Each item accepts a Telegram file_id, an http(s) URL, or an absolute local path, restricted to TELEGRAM_UPLOAD_ROOTS when it lists at least one directory (uploads up to 10 MB for photos and 50 MB otherwise). Captions are limited to 1024 characters and are never split. Supports reply, thread, silent and protected sending and returns JSON message identifiers with per-item file identifiers.","inputKeys":["chatId","disableNotification","media","messageThreadId","protectContent","replyToMessageId"]}
{"name":"send-message","description":"Send message using a chat id. Automatically splits long messages that exceed Telegram's 4096 character limit while preserving word boundaries and formatting. Supports common send options and returns JSON message identifiers.","inputKeys":["chatId","disableLinkPreview","disableNotification","messageThreadId","parseMode","protectContent","replyToMessageId","text"]}
{"name":"send-photo","description":"Send photo with caption using a chat id. Automatically handles long captions that exceed Telegram's character limit by splitting them across multiple messages. Captions exceeding 1024 characters continue as text messages; common send options and JSON message identifiers are supported. Media accepts a Telegram file_id, an http(s) URL, or an absolute local path, restricted to TELEGRAM_UPLOAD_ROOTS when it lists at least one directory (uploads up to 10 MB, with an optional filename).","inputKeys":["chatId","disableNotification","filename","media","messageThreadId","parseMode","protectContent","replyToMessageId","text"]}
{"name":"send-poll","description":"Send a native poll or quiz to a chat. Supports anonymous polls, multiple answers, and quiz mode with a correct answer. Supports common send options and returns JSON message identifiers.","inputKeys":["allowsMultipleAnswers","chatId","correctOptionId","disableNotification","isAnonymous","messageThreadId","options","protectContent","question","replyToMessageId","type"]}
{"name":"send-sticker","description":"Send a static .WEBP, animated .TGS, or video .WEBM sticker to a chat. Supports common send options and returns JSON message and file identifiers. Media accepts a Telegram file_id, an http(s) URL, or an absolute local path, restricted to TELEGRAM_UPLOAD_ROOTS when it lists at least one directory (uploads up to 50 MB, with an optional filename).","inputKeys":["chatId","disableNotification","filename","media","messageThreadId","protectContent","replyToMessageId"]}
{"name":"send-video","description":"Send a video to a chat. Telegram clients support MPEG4 videos (other formats may be sent as Document). Bots can send video files of up to 50 MB in size. Captions exceeding 1024 characters continue as text messages; common send options and JSON message identifiers are supported. Media accepts a Telegram file_id, an http(s) URL, or an absolute local path, restricted to TELEGRAM_UPLOAD_ROOTS when it lists at least one directory (uploads up to 50 MB, with an optional filename).","inputKeys":["caption","chatId","disableNotification","filename","media","messageThreadId","parseMode","protectContent","replyToMessageId"]}
{"name":"send-video-note","description":"Send a rounded square MPEG4 video message (video note) of up to 1 minute to a chat. Accepts a Telegram file_id or an absolute local path, restricted to TELEGRAM_UPLOAD_ROOTS when it lists at least one directory (uploads up to 50 MB, with an optional filename); Telegram does not accept video notes by URL. Video notes have no caption. Supports common send options and returns JSON message and file identifiers.","inputKeys":["chatId","disableNotification","duration","filename","length","messageThreadId","protectContent","replyToMessageId","videoNote"]}
{"name":"send-voice","description":"Send an audio file as a playable voice message. The file must be in .OGG format encoded with OPUS, or in .MP3/.M4A format. Captions exceeding 1024 characters continue as text messages; common send options and JSON message identifiers are supported. Media accepts a Telegram file_id, an http(s) URL, or an absolute local path, restricted to TELEGRAM_UPLOAD_ROOTS when it lists at least one directory (uploads up to 50 MB, with an optional filename); local audio that is not OGG/Opus is converted with ffmpeg.","inputKeys":["caption","chatId","disableNotification","duration","filename","media","messageThreadId","parseMode","protectContent","replyToMessageId"]}
{"name":"set-chat-description","description":"Change the description of a group, supergroup, or channel. The bot must be an administrator with the appropriate rights.","inputKeys":["chatId","description"]}
{"name":"set-chat-title","description":"Change the title of a group, supergroup, or channel. The bot must be an administrator with the appropriate rights.","inputKeys":["chatId","title"]}
{"name":"set-message-reaction","description":"Set the bot's emoji reaction on a message, or remove it by omitting the emoji. Telegram checks the emoji against its allowed reactions. Returns JSON { ok: true }.","inputKeys":["chatId","emoji","isBig","messageId"]}
{"name":"set-my-commands","description":"Use this method to change the list of the bot's commands","inputKeys":["commands"]}
{"name":"set-my-description","description":"Use this method to change the bot's description, which is shown in the chat with the bot if the chat is empty","inputKeys":["description"]}
{"name":"set-my-name","description":"Use this method to change the bot's name","inputKeys":["name"]}
{"name":"set-my-short-description","description":"Use this method to change the bot's short description, which is shown on the bot's profile page and is sent together with the link when users share the bot","inputKeys":["short_description"]}
{"name":"un-ban-chat-member","description":"Use this method to unban a previously banned user in a supergroup or channel. The user will not return to the group or channel automatically. Provides detailed error information if the operation fails.","inputKeys":["chatId","userId"]}
{"name":"unpin-all-chat-messages","description":"Unpin all pinned messages in a chat at once.","inputKeys":["chatId"]}
{"name":"unpin-chat-message","description":"Unpin a message in a chat. If no messageId is provided, the most recent pinned message is unpinned.","inputKeys":["chatId","messageId"]}
